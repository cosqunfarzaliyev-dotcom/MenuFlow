# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin panel access is handled by Supabase Auth (email/password), not an
# env variable. This app is multi-tenant:
#   1. Run supabase/migrations/0001_multi_tenant_saas.sql, then
#      supabase/migrations/0002_security_hardening.sql, then
#      supabase/migrations/0003_billing_self_service.sql, in your Supabase
#      project's SQL editor (in that order).
#   2. Restaurant owners sign up and create their own restaurant from
#      /onboarding (14-day free trial, no card needed) — or you can still
#      create one manually from /superadmin.
#   3. Promote that account to platform owner:
#        update public.profiles set role = 'super_admin' where email = 'you@example.com';
#   4. Log into /superadmin with that account to create restaurants and
#      assign restaurant_admin / staff accounts to them.
#
# /admin, /staff and /superadmin are protected server-side by middleware.js
# (checks the Supabase session + role on every request, before the page
# renders). This requires session cookies rather than localStorage, which is
# why lib/supabase.js uses @supabase/ssr's createBrowserClient — make sure
# `npm install` has pulled in the @supabase/ssr package after updating.
#
# Password reset: /login has a "Şifrəni unutmusunuz?" link that emails a
# recovery link to /reset-password. In Supabase dashboard > Authentication >
# URL Configuration, add {your-domain}/reset-password to Redirect URLs, or
# the email link will be rejected.
#
# Email confirmations: if Authentication > Providers > Email > "Confirm
# email" is ON (recommended), new sign-ups must click the link Supabase
# emails them before they can log in — /login already shows a clear message
# for that case.

# Supabase public credentials for client-side data access.
# Create a free project at https://supabase.com and update these values.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_ANON_KEY"
